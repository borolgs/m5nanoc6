# Copy to `.env`. Secrets only — the tunables live in `.cargo/config.toml`.
# `build.rs` feeds every line to the compiler, so all of this ends up in the firmware image:
# anyone who can dump the flash has it.

# All networks in one variable, tried in order:
#   WIFI_CREDS=ssid1,pass1;ssid2,pass2
# An entry without a comma is an open network. Whitespace around either half is ignored,
# so an SSID or password cannot begin or end with a space, nor contain a `,` or a `;`.
WIFI_CREDS=home,hunter2;coffee-shop

# Telegram notifier. Leave either one empty and the notifier stays off — see
# `docs/telegram-bot.md`. Paste the token in by hand from @BotFather.
TELEGRAM_TOKEN=
# Your chat id, from `getUpdates` after you send `/start` to the bot. Negative for groups.
TELEGRAM_CHAT_ID=
